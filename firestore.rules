rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // --- YARDIMCI GÜVENLİK FONKSİYONLARI ---
    // ==========================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Yalnızca Sistem Yöneticisi (Admin Bedirhan - abimer2350@gmail.com)
    function isAuthorizedUid() {
      return isSignedIn() && request.auth.uid == "p4h4hZYTtaPBk6kp1UUfRA7z2px2";
    }

    function isNonEmptyString(v) {
      return v is string && v.size() > 0;
    }

    function isNonNegativeNumber(v) {
      return v is number && v >= 0;
    }

    // ==========================================
    // --- CİHAZ YETKİLENDİRME (DEVICE FLOW) ---
    // ==========================================
    match /device_sessions/{sessionId} {
      // Koleksiyon listeleme tamamen kapalıdır (oturum ele geçirme engeli)
      allow list: if isAuthorizedUid();
      // Yalnızca kriptografik yüksek entropili sessionId bilen tekil belgeyi okuyabilir
      allow get: if sessionId.size() >= 16;

      allow create: if sessionId.size() >= 16
                    && (request.resource.data.status == "pending"
                        || (isSignedIn()
                            && request.resource.data.status == "authorized"
                            && request.resource.data.uid == request.auth.uid));

      allow update: if sessionId.size() >= 16
                    && (
                      (isSignedIn()
                        && request.resource.data.status == "authorized"
                        && request.resource.data.uid == request.auth.uid
                        && (resource.data.status == "pending" || resource.data.uid == request.auth.uid))
                      ||
                      (resource.data.status == "authorized"
                        && request.resource.data.status == "consumed"
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "consumedAt"]))
                    );

      allow delete: if isAuthorizedUid()
                    || (sessionId.size() >= 16 && resource.data.status in ["authorized", "consumed"]);
    }

    match /device_pairings/{code} {
      allow list: if isAuthorizedUid();
      allow get: if code.size() >= 6;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if code.size() >= 6
                    && resource.data.used != true
                    && request.resource.data.used == true
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["used", "usedAt", "terminalType"]);
      allow delete: if isAuthorizedUid();
    }

    // ==========================================
    // --- LİSANS İŞLEMLERİ (LİSANS ANAHTARLARI) ---
    // ==========================================
    match /licenses/{licenseId} {
      // Yalnızca bilinen anahtar tekil sorgulanabilir; toplu lisans listeleme sadece Yöneticidedir
      allow get: if licenseId.size() >= 6;
      allow list: if isAuthorizedUid();

      // Kullanıcı veya doğrulanmış masaüstü terminali yalnızca henüz kullanılmamış bir lisansı aktive edebilir (yetki/süre alanlarını değiştiremez)
      allow update: if (licenseId.size() >= 10
                        && (resource.data.status == "unused" || resource.data.isUsed != true)
                        && (request.resource.data.status == "activated" || request.resource.data.isUsed == true)
                        && (
                          (isSignedIn() && (request.resource.data.activatedBy == request.auth.uid || request.resource.data.activatedByUid == request.auth.uid))
                          || (isNonEmptyString(request.resource.data.activatedBy) && request.resource.data.activatedBy.size() >= 4)
                        )
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                            "status",
                            "activatedBy",
                            "activatedAt",
                            "activatedEmail",
                            "hardwareId",
                            "isUsed",
                            "activatedByUid"
                          ]))
                    || isAuthorizedUid();

      // Lisans oluşturma ve silme yetkisi sadece Yöneticidedir
      allow create, delete: if isAuthorizedUid();
    }

    // ==========================================
    // --- KULLANICI VERİLERİ (ARTIFACTS KOLEKSİYONU) ---
    // ==========================================
    match /artifacts/{artifactId} {

      match /device_pairings/{code} {
        allow list: if isAuthorizedUid();
        allow get: if code.size() >= 6;
        allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
        allow update: if code.size() >= 6
                      && resource.data.used != true
                      && request.resource.data.used == true
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["used", "usedAt", "terminalType"]);
        allow delete: if isAuthorizedUid();
      }

      // KULLANICILAR KOLEKSİYONU (Masaüstü cihaz akışı ve /api/sync uyumluluğu korunur)
      match /users/{userId} {
        allow read, write: if true;

        match /profile/{profileDocId} {
          allow read, write: if true;
        }

        match /products/{productId} {
          allow read, write: if true;
        }

        match /sales/{saleId} {
          allow read, write: if true;
        }

        match /ledger/{entryId} {
          allow read, write: if true;
        }

        match /customers/{customerId} {
          allow read, write: if true;

          match /sales/{saleSubId} {
            allow read, write: if true;
          }

          match /payments/{paymentId} {
            allow read, write: if true;
          }
        }

        match /settings/{settingId} {
          allow read, write: if true;
        }

        match /master_backup/{backupId} {
          allow read, write: if true;
        }

        match /sync_meta/{metaId} {
          allow read, write: if true;
        }

        match /legacy_incomes/{docId} {
          allow read, write: if true;
        }
        match /legacy_expenses/{docId} {
          allow read, write: if true;
        }

        match /{other=**} {
          allow read, write: if true;
        }
      }

      // ANKETLER KOLEKSİYONU (Yalnızca oturum açmış kendi kaydını yazabilir; dışarıdan silme/ezme kapalı)
      match /surveys/{surveyId} {
        allow read: if true;
        allow create, update: if isOwner(surveyId) || isAuthorizedUid();
        allow delete: if isAuthorizedUid();
      }
    }

    // ==========================================
    // --- SİSTEM POLİTİKASI & STOKPRO NOVA ---
    // ==========================================
    match /system_configs/app_policy {
      allow get: if true;
      allow list, write: if isAuthorizedUid();
    }

    match /system_configs/{configId} {
      allow read: if isSignedIn();
      allow write: if isAuthorizedUid();
    }

    match /nova_wallets/{userId} {
      allow read: if isOwner(userId) || isAuthorizedUid();
      allow write: if false;
    }

    match /nova_reservations/{reservationId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /nova_sessions/{sessionId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /nova_ledger/{entryId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /nova_usage_logs/{logId} {
      allow read: if isAuthorizedUid();
      allow write: if false;
    }

    // ==========================================
    // --- GLOBAL ADMİN PANEL ERİŞİMİ ---
    // ==========================================
    match /{document=**} {
      allow read, write: if isAuthorizedUid();
    }
  }
}
